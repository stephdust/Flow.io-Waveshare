on b0.down:
  vaLeapYear.val=0
  vaMaxD.val=31
  if(month.val==4||month.val==6||month.val==9||month.val==11)
  {
    vaMaxD.val=30
  }else if(month.val==2)
  {
    va0.val=year.val
    va1.val=year.val
    va2.val=year.val
    va0.val%=4
    va1.val%=100
    va2.val%=400
    if(va0.val==0&&va1.val!=0)
    {
      vaLeapYear.val=1
    }else if(va2.val==0)
    {
      vaLeapYear.val=1
    }
    if(vaLeapYear.val==1)
    {
      vaMaxD.val=29
    }else
    {
      vaMaxD.val=28
    }
  }
  if(day.val>vaMaxD.val)
  {
    day.val=vaMaxD.val
  }

on tm0.timer:
  sys0=globals.vaSwitches.val>>28   //NTP Ready
  sys0=sys0&1
  pNTPStatus.pic=-2*sys0+1+LEDpic
  if(sys0==1)
  {
    vis bApply,0
  }else
  {
    vis bApply,1
  }
  if(vaSec_Changed.val==0)
  {
    second.val=rtc5  // write the second box with RTC data
  }
  if(vaMin_Changed.val==0)
  {
    minute.val=rtc4  // write the minute box with RTC da
  }
  if(vaHou_Changed.val==0)
  {
    hour.val=rtc3
  }
  if(vaDay_Changed.val==0)
  {
    day.val=rtc2  // write the day box with RTC data
  }
  if(vaMon_Changed.val==0)
  {
    month.val=rtc1  // write the month box with RTC data
  }
  if(vaYea_Changed.val==0)
  {
    year.val=rtc0  // write the year box with RTC data
  }

on repeat_tm.timer:
  click b[button_i.val],1 //repeat
  tick_c.val++ // increment ticks counter
  if(tick_c.val==2)
  {
    repeat_tm.tim/=4 // handle acceleration
  }

on tc0.down:
  // check if the pressed component is a button and act accordingly
  // other conditions might be added with && if not all buttons shall repeat
  if(b[tc0.val].type==98)
  {
    // for multitouch screens: if a further button is pressed,
    // the repater will restart and act on the last pressed
    if(tc0.val!=button_i.val)
    {
      button_i.val=tc0.val
      repeat_tm.tim=500 // start with slow repeat
      tick_c.val=0 // reinitialize
    }
    repeat_tm.en=1 // start timer if not already running
  }

on tc0.up:
  // check if the pressed component is a button and act accordingly
  // other conditions might be added with && if not all buttons shall repeat
  if(b[tc0.val].type==98)
  {
    // for multitouch screens: check if the released button is the currently repeated one
    // the repater will stop and reinitialize the timer and tick counter
    if(tc0.val==button_i.val)
    {
      repeat_tm.en=0 // stop timer
      repeat_tm.tim=500 // start the next again  with slow repeat
      tick_c.val=0 // reinitialize
      button_i.val=0 // reinitialize
    }
  }
