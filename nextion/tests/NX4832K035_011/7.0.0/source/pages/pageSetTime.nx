on b2.down:
  vaMon_Changed.val=1
  month.pco=Green_Color
  if(month.val==12)
  {
    month.val=1
  }else
  {
    month.val++
  }
  click b0,1

on b3.down:
  vaYea_Changed.val=1
  year.pco=Green_Color
  year.val++
  click b0,1

on b4.down:
  vaHou_Changed.val=1
  hour.pco=Green_Color
  if(hour.val==23) // if hour is 23 (11 PM)
  {
    hour.val=0  // set hour as 0 (12 AM)
  }else  // since hour is not 23
  {
    hour.val++  // increase hour by 1
  }

on b5.down:
  vaMin_Changed.val=1
  minute.pco=Green_Color
  if(minute.val==59)  // if minute is 59
  {
    minute.val=0  // set minute as 0
  }else  // since minute is not 59
  {
    minute.val++  // increase minute by 1
  }

on b6.down:
  vaSec_Changed.val=1
  second.pco=Green_Color
  if(second.val==59)  // if second is 59
  {
    second.val=0  // set second as 0
  }else  // since second is not 59
  {
    second.val++  // increase second by 1
  }

on b7.down:
  vaDay_Changed.val=1
  day.pco=Green_Color
  if(day.val>1)
  {
    day.val--
  }else
  {
    day.val=vaMaxD.val
  }
  click b0,1

on b8.down:
  vaMon_Changed.val=1
  month.pco=Green_Color
  if(month.val==1)
  {
    month.val=12
  }else
  {
    month.val--
  }
  click b0,1

on b9.down:
  vaYea_Changed.val=1
  year.pco=Green_Color
  if(year.val>1900)
  {
    year.val--
  }
  click b0,1

on b10.down:
  vaHou_Changed.val=1
  hour.pco=Green_Color
  if(hour.val==0) // if hour is 0 (12 AM)
  {
    hour.val=23  // set hour as 23 (11 PM)
  }else  // since hour is not 0
  {
    hour.val-- // decrease hour by 1
  }

on b11.down:
  vaMin_Changed.val=1
  minute.pco=Green_Color
  if(minute.val==0)  // if minute is 0
  {
    minute.val=59  // set minute as 59
  }else  // since minute is not 0
  {
    minute.val--  // decrease minute by 1
  }

on b12.down:
  vaSec_Changed.val=1
  second.pco=Green_Color
  if(second.val==0)  // if second is 0
  {
    second.val=59  // set second as 59
  }else  // since second is not 0
  {
    second.val--  // decrease second by 1
  }

