on pageSetTime.load:
  printh 23 02 50 // Set page number in ESP
  prints ENP_DATETIME,1
  // The following is going to execute before we load this current page:
  vis b0,0
  // Choose which is the hour reference
  sys0=globals.vaSwitches.val>>28   //NTP Ready
  sys0=sys0&1
  second.val=rtc5  // write the second box with RTC data
  minute.val=rtc4  // write the minute box with RTC da
  hour.val=rtc3
  day.val=rtc2  // write the day box with RTC data
  month.val=rtc1  // write the month box with RTC data
  year.val=rtc0  // write the year box with RTC data
  //Update time source button
  if(sys0==1)
  {
    vis bApply,0
  }else
  {
    vis bApply,1
  }

on pageSetTime.unload:
  pageKeyPad.vaOkCancel.val=0

on m0.up:
  page PreviousPage

on bApply.up:
  rtc5=second.val  // write the second box with RTC data
  rtc4=minute.val  // write the minute box with RTC data
  rtc3=hour.val
  rtc2=day.val  // write the day box with RTC data
  rtc1=month.val  // write the month box with RTC data
  rtc0=year.val  // write the year box with RTC data
  globals.vaCommand.txt="{\"SetDateTime\":["
  covx hour.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+=","
  covx minute.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+=","
  covx second.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+=","
  covx day.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+=","
  covx month.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+=","
  covx year.val,vaTmp.txt,0,0
  globals.vaCommand.txt+=vaTmp.txt
  globals.vaCommand.txt+="]}"
  printh 23 01 43  // Execture arbitrary commands
  page PreviousPage  // go to page 0

on b1.down:
  vaDay_Changed.val=1
  day.pco=Green_Color
  if(day.val<vaMaxD.val)
  {
    day.val++
  }else
  {
    day.val=1
  }
  click b0,1

