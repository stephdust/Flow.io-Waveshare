on pageHome.load:
  // Re-enter this page after automatic wake: custom xpic layers require full redraw.
  wup=1
  printh 23 02 50 00
  printh 23 03 60 03 00
  vis bUpdateGauge,0
  vis bDateTime,0
  vis bInjectUpdt,0
  vis tFConnectState,0
  // Original glyph stays present for older builds, but the live RSSI uses
  // colorful xpic sprites in the same header slot.
  vis tWifiState,0
  // The empty scrolling-text alarm must not paint an opaque horizontal bar.
  vis tErrMessage,0
  // tProp component retained for compatibility; centered rotating bitmaps are drawn via xpic.
  vis tProp,0

on pageHome.loadend:
  // Draw the complete navy Flow.io background from the extra atlas rows.
  // Leave native component IDs, timers and touch events unchanged.
  vis tPHTitle,0
  vis tOrpTitle,0
  xpic 0,0,480,320,0,300,HomeGaugepic
  // Force BOTH gauge sprites to be redrawn after every page load/wake.
  vaPrvpHPercen.val=-1
  vaPrvOrpPercen.val=-1
  vaPrvWifiLevel.val=-1
  vaPrvPSINid.val=-1
  // Restore live native components that the background image covered.
  ref tWaterTemp
  ref tAirTemp
  ref tTime
  ref tDate
  // WiFi and FlowConnect legacy glyphs are hidden (new RSSI xpic).
  ref tFConnectState
  ref tpH
  ref tORP
  // Paint the OFF pressure ring, then its independent central turbine.
  // The timer changes only the 42x42 centre on each 50ms tick.
  xpic 207,210,70,70,0,620,HomeGaugepic
  xpic 221,224,42,42,350,620,HomeGaugepic
  ref tpHInject
  ref tChlInject
  ref tSWGRunning
  // Only useful footer actions remain: grid/config, gear/switches,
  // alarm/alarms and central turbine/filtration. All touch targets are
  // invisible and aligned with their artwork, without opaque buttons.
  // Alarm text is shown by bUpdateGauge only while nonempty.
  // Update the values
  click bUpdateGauge,1
  //Update Injection Icons
  click bInjectUpdt,1
  //Update Date Time
  click bDateTime,1

on pageHome.unload:
  // Preserve ordinary wake behavior when visiting config/alarms/other pages.
  wup=255
  PreviousPage=dp

on tmAnim.timer:
  // Ten shared core phases rotate four identical blades; independent from PSI.
  // Repaint the 70x70 ring only when pressure severity changes.
  temp1=globals.vaStates.val>>0
  temp1=temp1&1
  if(temp1==1)
  {
    temp%=10
    temp+=1
  }else
  {
    temp=0
  }
  sys1=vaPSINiddle.val
  if(sys1>4)
  {
    sys1=4
  }
  if(sys1<0)
  {
    sys1=0
  }
  if(sys1!=vaPrvPSINid.val)
  {
    vaPrvPSINid.val=sys1
    sys0=sys1*70
    xpic 207,210,70,70,sys0,620,HomeGaugepic
  }
  sys0=temp*42
  sys0+=350
  xpic 221,224,42,42,sys0,620,HomeGaugepic

on tmUpdate.timer:
  // Update the values
  click bUpdateGauge,1

on bUpdateGauge.down:
  //Update Blinking
  // Only draw the alert banner while a message exists.  Otherwise the
  // scrolling-text widget paints an opaque stripe over the green markers.
  if(tErrMessage.txt!=globals.vaErrMsg.txt)
  {
    tErrMessage.txt=globals.vaErrMsg.txt
    if(tErrMessage.txt=="")
    {
      vis tErrMessage,0
      xpic 63,57,378,30,63,357,HomeGaugepic
    }else
    {
      vis tErrMessage,1
    }
  }
  //Update Values
  tORP.txt=globals.vaOrpValue.txt
  tpH.txt=globals.vaPhValue.txt
  tWaterTemp.txt=globals.vaWaterTemp.txt
  tAirTemp.txt=globals.vaAirTemp.txt
  // Pump ring severity is read by tmAnim. Legacy tProp stays hidden.
  // Real RSSI 0..4, encoded by ESP32 in Home state bits 16..18.
  // Previous WiFi/MQTT state bits 7/8 remain available to legacy screens.
  sys0=globals.vaStates.val/65536
  sys0=sys0%8
  if(sys0>4)
  {
    sys0=0
  }
  if(sys0!=vaPrvWifiLevel.val)
  {
    vaPrvWifiLevel.val=sys0
    sys1=sys0*43
    xpic 428,11,43,38,sys1,690,HomeGaugepic
  }
  //// pH Gauge
  if(vapHPercent.val!=vaPrvpHPercen.val)
  {
    vaPrvpHPercen.val=vapHPercent.val
    sys0=vapHPercent.val+35
    sys0=sys0/70
    if(sys0>4)
    {
      sys0=4
    }
    sys1=sys0*207
    xpic 20,89,207,150,sys1,0,HomeGaugepic
    if(sys0==0||sys0==4)
    {
      tpH.bco=132
    }
    if(sys0==1||sys0==3)
    {
      tpH.bco=132
    }
    if(sys0==2)
    {
      tpH.bco=132
    }
    vis tpH,1
    // Real 3D measurement needle (21 positions), not a 22px rim tick.
    // Both dial sprites have a completely uniform navy background.
    sys2=vapHPercent.val
    if(sys2>280)
    {
      sys2=280
    }
    sys2+=7
    sys2=sys2/14
    if(sys2==0)
    {
      line 125,161,43,160,841
      line 123,161,42,160,2015
