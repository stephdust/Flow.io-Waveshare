  //// ORP Gauge
  if(vaOrpPercent.val!=vaPrvOrpPercen.val)
  {
    vaPrvOrpPercen.val=vaOrpPercent.val
    sys0=vaOrpPercent.val+35
    sys0=sys0/70
    if(sys0>4)
    {
      sys0=4
    }
    sys1=sys0*207
    xpic 253,89,207,150,sys1,150,HomeGaugepic
    if(sys0==0||sys0==4)
    {
      tORP.bco=132
    }
    if(sys0==1||sys0==3)
    {
      tORP.bco=132
    }
    if(sys0==2)
    {
      tORP.bco=132
    }
    vis tORP,1
    // Measured position, derived from the ESP32 setpoint-relative 0..280 gauge.
    // 21 narrow white/cyan cursor bars follow the 180-degree dial, not a
