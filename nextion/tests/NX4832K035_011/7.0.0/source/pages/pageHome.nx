on tmBlink.timer:
  //Error Toggle
  ErrorToggle+=1
  ErrorToggle%=2
  click bInjectUpdt,1

on bInjectUpdt.down:
  // Visible or not
  //// pH Injection Pump if AutoMode
  sys1=globals.vaStates.val>>4   // pH AutoMode
  sys1=sys1&1
  if(sys1==1)
  {
    vis tpHInject,1
  }else
  {
    vis tpHInject,0
  }
  //// Chl Injection Pump if AutoMode
  sys1=globals.vaStates.val>>5   // Orp AutoMode
  sys1=sys1&1
  if(sys1==1)
  {
    vis tChlInject,1
  }else
  {
    vis tChlInject,0
  }
  //// SWG if AutoMode
  sys1=globals.vaStates.val>>13   // SWG AutoMode
  sys1=sys1&1
  if(sys1==1)
  {
    vis tSWGRunning,1
  }else
  {
    vis tSWGRunning,0
  }
  // Blinking or not (please note that if it blinks, turn the visibility on)
  //// pH Injection Pump
  sys1=globals.vaStates.val>>1   // pH Injection Pump status
  sys1=sys1&1
  if(sys1==1&&ErrorToggle==1)
  {
    tpHInject.pco=Green_Color
    vis tpHInject,1
  }else
  {
    tpHInject.pco=Grey_Color
  }
  //// Chl Injection Pump
  sys1=globals.vaStates.val>>2   // Chl Injection Pump status
  sys1=sys1&1
  if(sys1==1&&ErrorToggle==1)
  {
    tChlInject.pco=Green_Color
    vis tChlInject,1
  }else
  {
    tChlInject.pco=Grey_Color
  }
  //// SWG
  sys1=globals.vaStates.val>>14   // SWG
  sys1=sys1&1
  if(sys1==1&&ErrorToggle==1)
  {
    tSWGRunning.pco=Green_Color
    vis tSWGRunning,1
  }else
  {
    tSWGRunning.pco=Grey_Color
  }
  doevents

on b0.up:
  page pageCfgMenu

on bDateTime.down:
  // Build Time
  vaTmpDateTime.txt=""
  covx rtc3,vaBuildDatTime.txt,2,0
  vaTmpDateTime.txt+=vaBuildDatTime.txt
  vaTmpDateTime.txt+=":"
  covx rtc4,vaBuildDatTime.txt,2,0
  vaTmpDateTime.txt+=vaBuildDatTime.txt
  if(vaTmpDateTime.txt!=tTime.txt)
  {
    tTime.txt=vaTmpDateTime.txt
  }
  // Build Date DD/MM/YY
  covx rtc2,tDate.txt,2,0
  tDate.txt+="/"
  covx rtc1,vaBuildDatTime.txt,2,0
  tDate.txt+=vaBuildDatTime.txt
  tDate.txt+="/"
  sys0=rtc0%100
  covx sys0,vaBuildDatTime.txt,2,0
  tDate.txt+=vaBuildDatTime.txt
  // Date from RTC

on tmDateTime.timer:
  click bDateTime,1

on m0.down:
  page pageHomeSwtch

on m1.down:
  // Touch the actual 70x70 spinning pump, not the surrounding gauges.
  printh 23 03 60 09 01

on b1.down:
  // Alarm icon opens alarms only. Do not navigate to configuration on release.
  page pageAlarms
