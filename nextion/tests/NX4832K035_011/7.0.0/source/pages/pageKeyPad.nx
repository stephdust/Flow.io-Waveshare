on pageKeyPad.load:
  printh 23 02 50  // Set page number in ESP
  prints ENP_KEYPAD,1
  //Get the source component value
  t0.txt=p[vaReturnPage.val].b[vaReturnObjId.val].txt
  if(t0.txt!="") // If text is empty, leave empty to start editing new number from scratch
  {
    //If not empty, ensure that the number corresponds to standard and correct if needed
    click bCleanText,1
  }
  //If value does not expect . hide the button
  if(vaTxtMaxAp.val==0)
  {
    vis b11,0
  }
  //Hide the function buttons
  vis bCleanText,0
  vis bCheckLength,0
  vis t2,0
  //Write Maxi and mini values for convenience
  tName2.txt="["
  covx vaMini.val,va3.txt,0,0
  tName2.txt+=va3.txt
  tName2.txt+="-"
  covx vaMaxi.val,va3.txt,0,0
  tName2.txt+=va3.txt
  tName2.txt+="]"
  // Look for an existing comma in the current text
  vaNbPts.val=0
  va3.txt=t0.txt+"-"
  spstr va3.txt,va4.txt,".",1
  strlen va4.txt,va2.val
  if(va2.val>0)
  {
    vaNbPts.val+=1
  }
  //Intialize the variable which tells source page if enter was presed
  vaOkCancel.val=0

on b10.down:
  if(t0.txt=="0")
  {
    t0.txt+=""
  }
  t2.txt="0"
  click bCheckLength,1
  t0.txt+=t2.txt

