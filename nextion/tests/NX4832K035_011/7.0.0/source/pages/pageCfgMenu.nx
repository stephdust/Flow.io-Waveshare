on tmReboot.timer:
  vaRebtCounter.val+=1
  if(vaRebtCounter.val<=bHome.w)
  {
    fill bHome.x,bHome.y,vaRebtCounter.val,bHome.h,62307
  }else
  {
    //printh 23 01 43  // Execture arbitrary commands
    tmReboot.en=0
    vaRebtCounter.val=0
    page pageReboot
  }
