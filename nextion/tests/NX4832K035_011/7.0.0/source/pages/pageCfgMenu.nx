on tV0.down:
  if(vaEditType0.val==0) // TEXT
  {
    pageKeyBoard.InputCommand.txt=tV0.txt
    globals.vaKbdCtxRef.val=vaCtxRef.val
    globals.vaKbdRow.val=0
    printh 23 02 50 0B
    page pageKeyBoard
  }else if(vaEditType0.val==1) // INTEGER
  {
    globals.vaKbdCtxRef.val=vaCtxRef.val
    globals.vaKbdRow.val=0
    pageKeyPad.vaReturnPage.val=dp
    pageKeyPad.vaTxtMaxAv.val=5
    pageKeyPad.vaTxtMaxAp.val=0
    pageKeyPad.vaMaxi.val=9999
    pageKeyPad.vaMini.val=0
    pageKeyPad.tName.txt=tL0.txt
    pageKeyPad.tName.txt+="\r"
    pageKeyPad.tName.txt+=tV0.txt
    pageKeyPad.tName.txt+=" "
    printh 23 02 50 0B
    page pageKeyPad
  }else if(vaEditType0.val==2) // FLOAT
  {
    globals.vaKbdCtxRef.val=vaCtxRef.val
    globals.vaKbdRow.val=0
    pageKeyPad.vaReturnPage.val=dp
    pageKeyPad.vaTxtMaxAv.val=5
    pageKeyPad.vaTxtMaxAp.val=2
    pageKeyPad.vaMaxi.val=9999
    pageKeyPad.vaMini.val=0
    pageKeyPad.tName.txt=tL0.txt
    pageKeyPad.tName.txt+="\r"
    pageKeyPad.tName.txt+=tV0.txt
    pageKeyPad.tName.txt+=" "
    printh 23 02 50 0B
    page pageKeyPad
  }else if(vaEditType0.val==3) // BOOLEAN
  {
    printh 23 02 52 00
  }

