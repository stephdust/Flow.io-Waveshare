on bPrev.up:
  printh 23 02 51 05

on bNext.up:
  printh 23 02 51 04

on bBack.up:
  printh 23 02 51 02

on bReboot.down:
  // 40 ticks x 50 ms = 2 seconds.
  vaRebtCounter.val=0
  tmReboot.en=1

on bReboot.up:
  // Releasing early cancels restart and redraws the visible button.
  tmReboot.en=0
  vaRebtCounter.val=0
  ref bReboot

on tmReboot.timer:
  vaRebtCounter.val+=1
  if(vaRebtCounter.val<40)
  {
    // Thin hold indicator below the label: never paint over the power icon.
    fill bReboot.x+6,bReboot.y+49,vaRebtCounter.val,2,65535
  }else
  {
    tmReboot.en=0
    vaRebtCounter.val=0
    page pageReboot
  }
