on pageCfgMenu.load:
  if(globals.vaKbdCtxRef.val>0)
  {
    printh 23 06 50 0A
    print globals.vaKbdCtxRef.val
    globals.vaKbdCtxRef.val=0
  }else
  {
    printh 23 02 50 0A
  }
  tmReboot.en=0
  vaRebtCounter.val=0
  vaCfgEdit.val=0
  vis tL0,0
  vis tL1,0
  vis tL2,0
  vis tL3,0
  vis tL4,0
  vis tL5,0
  vis tV0,0
  vis tV1,0
  vis tV2,0
  vis tV3,0
  vis tV4,0
  vis tV5,0
  vis bR0,0
  vis bR1,0
  vis bR2,0
  vis bR3,0
  vis bR4,0
  vis bR5,0

on pageCfgMenu.unload:
  tmReboot.en=0
  printh 23 02 51 06

on tPath.up:
  printh 23 02 51 02

on bHome.down:
  // A normal Home press navigates immediately, never rebooting.
  page pageHome

on bValid.down:
  printh 23 02 51 03

on tL0.down:
  printh 23 02 52 00

on tL1.down:
  printh 23 02 52 01

on tL2.down:
  printh 23 02 52 02

on tL3.down:
  printh 23 02 52 03

on tL4.down:
  printh 23 02 52 04

on tL5.down:
  printh 23 02 52 05

on bR0.down:
  // The full row is clickable: browse enters a folder/leaf,
  // edit delegates to the existing text/number/switch value handler.
  if(vaCfgEdit.val==0)
  {
    printh 23 02 52 00
  }else
  {
    click tV0,1
  }

