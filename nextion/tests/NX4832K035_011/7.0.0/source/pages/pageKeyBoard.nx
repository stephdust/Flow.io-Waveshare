on SetNum2.down:
  vis b30,1
  vis b31,1
  vis b32,1
  vis b33,1
  vis b20,0
  vis b21,0
  vis b22,0
  vis b23,0
  vis b24,0
  vis b25,0
  vis b26,0
  vis b10,0
  vis b19,0
  b0.txt="`"
  b1.txt="|"
  b2.txt="{"
  b3.txt="}"
  b4.txt="?"
  b5.txt="%"
  b6.txt="^"
  b7.txt="*"
  b8.txt="/"
  b9.txt="'"
  b10.txt=""
  b11.txt="$"
