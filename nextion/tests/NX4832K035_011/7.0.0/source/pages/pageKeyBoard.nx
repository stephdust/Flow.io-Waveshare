  vis b21,1
  vis b22,1
  vis b23,1
  vis b24,1
  vis b25,1
  vis b26,1
  vis b10,1
  vis b19,1
  b0.txt="a"
  b1.txt="z"
  b2.txt="e"
  b3.txt="r"
  b4.txt="t"
  b5.txt="y"
  b6.txt="u"
