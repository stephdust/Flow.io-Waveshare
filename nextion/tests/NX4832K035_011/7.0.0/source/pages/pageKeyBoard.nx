on pageKeyBoard.load:
  //printh 23 02 50 // Set page number in ESP
  //prints ENP_KEYPAD,1
  //Hide the command button
  vis SetLow,0
  vis SetHigh,0
  vis SetNum1,0
  vis SetNum2,0
  vis t2,0
  //Initialize
  click SetLow,1

on tc0.down:
  tm0.en=0
  tm1.en=0
  // Only relevant keys
  sys0=0
  if(tc0.val>=b0.id&&tc0.val<=b33.id)
  {
    sys0=1
  }
  if(tc0.val==Del.id)
  {
    sys0=1
  }
  if(sys0==1)
  {
    if(vaKBTouched.val==0)
    {
      firstKey.val=0
      InputCommand.txt=""
      vaKBTouched.val=1
    }
    if(tc0.val==Del.id)
    {
      InputCommand.txt-=1 // Delete a character
    }else
    {
      InputCommand.txt+=b[tc0.val].txt   //Input New Txt
    }
    t0.pco=0
    vaToggle.val=0
  }
  if(CurrentLayout.val==1&&tc0.val!=Shift.id)
  {
    CurrentLayout.val=0
    click SetLow,1
    Shift.pic=kpad_shift_up
    Shift.pic2=kpad_shift_up
  }

on tc0.up:
  tm0.en=1
  tm1.en=1

on SetLow.down:
  vis b30,0
  vis b31,0
  vis b32,0
  vis b33,0
