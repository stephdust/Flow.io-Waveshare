on Num.down:
  if(CurrentLayout.val==0||CurrentLayout.val==1)
  {
    CurrentLayout.val=2
    click SetNum1,1
    Shift.pic=kpad_shift_up
    Shift.pic2=kpad_shift_up
    Shift.pco=0
    Shift.txt="#+="
    Num.txt="ABC"
  }else if(CurrentLayout.val==2||CurrentLayout.val==3)
  {
    CurrentLayout.val=0
    click SetLow,1
    Shift.txt=t2.txt
    Num.txt="123"
  }

on Shift.down:
  if(CurrentLayout.val==0)
  {
    CurrentLayout.val=1
    click SetHigh,1
    Shift.pic=kpad_shift_down
    Shift.pic2=kpad_shift_down
  }else if(CurrentLayout.val==1)
  {
    CurrentLayout.val=0
    click SetLow,1
    Shift.pic=kpad_shift_up
    Shift.pic2=kpad_shift_up
  }else if(CurrentLayout.val==2)
  {
    CurrentLayout.val=3
    click SetNum2,1
    Shift.txt="123"
  }else if(CurrentLayout.val==3)
  {
    CurrentLayout.val=2
    click SetNum1,1
    Shift.txt="#+="
  }

on Enter.up:
  btlen InputCommand.txt,sys0
  if(sys0>47)
  {
    sys0=47
  }
  sys1=sys0+2
  // 1) Annonce du contexte menu (reste sur la page clavier)
  printh 23
  printh 06
  printh 50 0A
  print globals.vaKbdCtxRef.val
  // 2) Envoi de la valeur texte
  printh 23
  prints sys1,1
  printh 56
  prints globals.vaKbdRow.val,1
  prints InputCommand.txt,sys0
  page pageCfgMenu

on tm0.timer:
  if(vaToggle.val==0)
  {
    t0.txt+="_"
  }else
  {
    t0.txt-=1
  }
  vaToggle.val+=1
  vaToggle.val%=2

on tm1.timer:
  if(InputCommand.txt!=prevInputCmd.txt)
  {
    t0.txt=" "
    t0.txt+=InputCommand.txt
    prevInputCmd.txt=InputCommand.txt
  }

on Back.down:
  vaKBTouched.val=0

on Back.up:
  // 1) Annonce du contexte menu (reste sur la page clavier)
  printh 23
  printh 06
  printh 50 0A
  print globals.vaKbdCtxRef.val
  page pageCfgMenu
