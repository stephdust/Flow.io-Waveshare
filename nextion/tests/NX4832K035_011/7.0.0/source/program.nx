//The following code is only run once when power on, and is generally used for global variable definition and power on initialization data
int sys0=0,sys1=0,sys2=0     //At present, the definition of global variable only supports 4-byte signed integer (int), and other types of global quantity declaration are not supported. If you want to use string type, you can use variable control in the page to implement
int gest_x=0,gest_y=0,gest_dx=0,gest_dy=0,gest_dsq=0,gest_time=0,gest_type=0,tmp=0
int temp=0
int temp1=0
int temp2=0
int temp3=0
int temp4=0
int temp5=0
int temp6=0
int tempdotpage=0,tempdotspc=30,tempdottensP=0,tempdottens=0,tempdotdir=1,tempdotaccel=10,tempdot2=0,tempdot3=0,tempdot4=0,tempdot5=0,temphoriz=0
int tempIsError=0   // Variable used to store whether there is an active error when loading page (to draw the alarm signal)
int ErrorToggle=0   // Used to make icons blink
int PreviousPage=1 // Used as return function
int LongPressNumber=0
